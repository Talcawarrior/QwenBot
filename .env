# QwenBot - PolyMarket Weather Betting Bot Configuration
# DRY_RUN=true ise gerçek para kullanmaz, sadece simüle eder (test için güvenli)

# === Genel Ayarlar ===
DRY_RUN=true
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
HOST=127.0.0.1
PORT=8091

# === Portföy & Risk ===
INITIAL_PORTFOLIO=1000.0
SMART_POOL_PCT=0.40
MAX_EXPOSURE_PCT=0.25
MAX_BET_PCT=0.03
MIN_BET_SIZE=1.0
KELLY_FRACTION=0.15
DAILY_LOSS_LIMIT=0.05
CITY_CAP=4

# === Zamanlama (saniye) ===
SCAN_INTERVAL=300
SETTLEMENT_INTERVAL=120
SIA_INTERVAL=86400

# === Polymarket API (gerçek işlem için gerekli - DRY_RUN modunda boş bırakılabilir) ===
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === Weather API (opsiyonel) ===
WEATHERAPI_KEY=

# === Veritabanı ===
DB_PATH=data/bot.db
DB_ECHO=false
